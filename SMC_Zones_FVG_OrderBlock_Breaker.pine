//@version=6
indicator("SMC Zones — FVG, Order Block & Breaker", shorttitle="SMC Zones", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ══════════════════════════════════════════════════════════════════════════════
// A — SWING STRUCTURE
// ══════════════════════════════════════════════════════════════════════════════
grpA        = "A — Swing Structure"
swingLength = input.int(5,    "Swing Length",    minval=2, maxval=20, group=grpA)
showBOS     = input.bool(true, "Show BOS",       group=grpA)
showCHoCH   = input.bool(true, "Show CHoCH",     group=grpA)
colorBOS    = input.color(color.new(#2196F3, 0), "BOS Color",   group=grpA)
colorCHoCH  = input.color(color.new(#FF5722, 0), "CHoCH Color", group=grpA)

// ══════════════════════════════════════════════════════════════════════════════
// B — DISPLACEMENT
// ══════════════════════════════════════════════════════════════════════════════
grpB      = "B — Displacement"
displMode = input.string("ATR×1.25", "Mode", options=["ATR×1.25","Body×1.50 Avg"], group=grpB)
atrPeriod = input.int(14,   "ATR Period",      minval=5,   group=grpB)
atrMult   = input.float(1.25,"ATR Multiplier", minval=0.5, step=0.05, group=grpB)
bodyMult  = input.float(1.50,"Body Multiplier",minval=0.5, step=0.05, group=grpB)

// ══════════════════════════════════════════════════════════════════════════════
// C — FAIR VALUE GAP
// ══════════════════════════════════════════════════════════════════════════════
grpC         = "C — Fair Value Gap"
showFVG      = input.bool(true,   "Show FVG",          group=grpC)
minFvgAtr    = input.float(0.10,  "Min FVG (× ATR)",   minval=0.01, step=0.01, group=grpC)
fvgFillMode  = input.string("Touch","Fill on",         options=["Touch","50%","Full"], group=grpC)
showIFVG     = input.bool(true,   "Show IFVG",         group=grpC)
colorFVGBull = input.color(color.new(#00C853, 75), "Bull FVG", group=grpC)
colorFVGBear = input.color(color.new(#D50000, 75), "Bear FVG", group=grpC)
colorIFVG    = input.color(color.new(#AA00FF, 75), "IFVG",     group=grpC)
maxFVG       = input.int(10, "Max FVG Zones", minval=1, maxval=50, group=grpC)

// ══════════════════════════════════════════════════════════════════════════════
// D — ORDER BLOCK
// ══════════════════════════════════════════════════════════════════════════════
grpD        = "D — Order Block"
showOB      = input.bool(true,       "Show OB",        group=grpD)
obLookback  = input.int(12,          "Lookback Bars",  minval=3, maxval=50, group=grpD)
obSource    = input.string("Full Range","OB Source",   options=["Full Range","Body Only"], group=grpD)
maxOB       = input.int(8,           "Max OB Zones",   minval=1, maxval=20, group=grpD)
colorOBBull = input.color(color.new(#1565C0, 70), "Bull OB", group=grpD)
colorOBBear = input.color(color.new(#B71C1C, 70), "Bear OB", group=grpD)

// ══════════════════════════════════════════════════════════════════════════════
// E — BREAKER BLOCK
// ══════════════════════════════════════════════════════════════════════════════
grpE       = "E — Breaker Block"
showBB     = input.bool(true, "Show Breakers",          group=grpE)
colorBBBull= input.color(color.new(#FF6F00, 70), "Bull Breaker", group=grpE)
colorBBBear= input.color(color.new(#6A1B9A, 70), "Bear Breaker", group=grpE)
showBBRe   = input.bool(true, "Highlight Retest",       group=grpE)

// ══════════════════════════════════════════════════════════════════════════════
// F — DISPLAY
// ══════════════════════════════════════════════════════════════════════════════
grpF            = "F — Display"
zoneBorderWidth = input.int(1,        "Border Width",   minval=1, maxval=3, group=grpF)
extendZones     = input.bool(true,    "Extend Zones",   group=grpF)
labelSize       = input.string("small","Label Size",    options=["tiny","small","normal","large"], group=grpF)

// ══════════════════════════════════════════════════════════════════════════════
// G — ALERTS
// ══════════════════════════════════════════════════════════════════════════════
grpG         = "G — Alerts"
alertOnBOS   = input.bool(true, "Alert: BOS",   group=grpG)
alertOnCHoCH = input.bool(true, "Alert: CHoCH", group=grpG)
alertOnFVG   = input.bool(true, "Alert: FVG",   group=grpG)
alertOnOB    = input.bool(true, "Alert: OB",    group=grpG)
alertOnBB    = input.bool(true, "Alert: BB",    group=grpG)
alertOnIFVG  = input.bool(true, "Alert: IFVG",  group=grpG)
alertOnEntry = input.bool(true, "Alert: Entry Setup", group=grpG)

// ══════════════════════════════════════════════════════════════════════════════
// H — ENTRY SETUP (NEW)
// ══════════════════════════════════════════════════════════════════════════════
grpH         = "H — Entry Setup"
showEntry    = input.bool(true,  "Show Entry Setups",    group=grpH)
htfTF        = input.timeframe("60", "HTF Bias TF",      group=grpH,
                 tooltip="Higher TF for trend direction filter.\nExamples: 1m chart → '15', 5m chart → '60', 15m chart → '240'")
htfEmaLen    = input.int(50,    "HTF EMA Length",        minval=10, group=grpH)
confType     = input.string("Both", "Confirmation Type", options=["Engulfing","Pin Bar","Both"], group=grpH)
showSLLine   = input.bool(true,  "Show SL Level Line",   group=grpH)
colorSetupL  = input.color(color.new(#00E676, 0), "Setup Long Color",  group=grpH)
colorSetupS  = input.color(color.new(#FF1744, 0), "Setup Short Color", group=grpH)

// ══════════════════════════════════════════════════════════════════════════════
// CORE CALCULATIONS
// ══════════════════════════════════════════════════════════════════════════════
atrVal     = ta.atr(atrPeriod)
avgBody    = ta.sma(math.abs(close - open), 20)
candleBody = math.abs(close - open)

isDisplacement = switch displMode
    "ATR×1.25"      => candleBody >= atrMult * atrVal
    "Body×1.50 Avg" => candleBody >= bodyMult * avgBody
    => false

swingHigh = ta.pivothigh(high, swingLength, swingLength)
swingLow  = ta.pivotlow(low,  swingLength, swingLength)

var float lastSwingH  = na
var float lastSwingL  = na
var float lastBrokenH = na   // consumed levels — prevent BOS refire
var float lastBrokenL = na
var int   trendBias   = 0    // 1=bull, -1=bear, 0=init

if not na(swingHigh)
    lastSwingH := swingHigh
if not na(swingLow)
    lastSwingL := swingLow

_lblSize = switch labelSize
    "tiny"   => size.tiny
    "small"  => size.small
    "normal" => size.normal
    "large"  => size.large
    => size.small

// ── BOS / CHoCH ─────────────────────────────────────────────────────────────
var bool bosBull   = false
var bool bosBear   = false
var bool chochBull = false
var bool chochBear = false
bosBull   := false
bosBear   := false
chochBull := false
chochBear := false

if barstate.isconfirmed
    if trendBias == 0
        if not na(lastSwingH) and close > lastSwingH
            trendBias := 1
            lastBrokenH := lastSwingH
        else if not na(lastSwingL) and close < lastSwingL
            trendBias := -1
            lastBrokenL := lastSwingL
    else if not na(lastSwingH) and close > lastSwingH and lastSwingH != lastBrokenH
        if trendBias == 1
            bosBull := true
        else
            chochBull := true
            trendBias := 1
        lastBrokenH := lastSwingH
    else if not na(lastSwingL) and close < lastSwingL and lastSwingL != lastBrokenL
        if trendBias == -1
            bosBear := true
        else
            chochBear := true
            trendBias := -1
        lastBrokenL := lastSwingL

if showBOS and bosBull
    label.new(bar_index, high, "BOS↑", style=label.style_label_up,
         color=colorBOS, textcolor=color.white, size=_lblSize)
if showBOS and bosBear
    label.new(bar_index, low,  "BOS↓", style=label.style_label_down,
         color=colorBOS, textcolor=color.white, size=_lblSize)
if showCHoCH and chochBull
    label.new(bar_index, high, "CHoCH↑", style=label.style_label_up,
         color=colorCHoCH, textcolor=color.white, size=_lblSize)
if showCHoCH and chochBear
    label.new(bar_index, low,  "CHoCH↓", style=label.style_label_down,
         color=colorCHoCH, textcolor=color.white, size=_lblSize)

// ══════════════════════════════════════════════════════════════════════════════
// HTF BIAS (Section H helper)
// Uses EMA on the higher timeframe — non-repainting (lookahead off by default)
// ══════════════════════════════════════════════════════════════════════════════
htfClose = request.security(syminfo.tickerid, htfTF, close[1], lookahead=barmerge.lookahead_off)
htfEma   = request.security(syminfo.tickerid, htfTF, ta.ema(close, htfEmaLen)[1], lookahead=barmerge.lookahead_off)
htfBull  = htfClose > htfEma
htfBear  = htfClose < htfEma

// ══════════════════════════════════════════════════════════════════════════════
// FAIR VALUE GAPS
// ══════════════════════════════════════════════════════════════════════════════
var array<float> fvgTop    = array.new<float>()
var array<float> fvgBot    = array.new<float>()
var array<bool>  fvgIsBull = array.new<bool>()
var array<bool>  fvgActive = array.new<bool>()
var array<box>   fvgBoxes  = array.new<box>()

var bool newFVGBull = false
var bool newFVGBear = false
newFVGBull := false
newFVGBear := false

if barstate.isconfirmed and showFVG
    szBull = low   - high[2]
    szBear = low[2] - high
    rEdge  = extendZones ? bar_index + 50 : bar_index + 10

    if szBull > minFvgAtr * atrVal
        newFVGBull := true
        b = box.new(bar_index - 2, low, rEdge, high[2],
             border_color=colorFVGBull, bgcolor=colorFVGBull, border_width=zoneBorderWidth)
        array.push(fvgTop, low) ; array.push(fvgBot, high[2])
        array.push(fvgIsBull, true) ; array.push(fvgActive, true) ; array.push(fvgBoxes, b)
        if array.size(fvgTop) > maxFVG
            box.delete(array.shift(fvgBoxes))
            array.shift(fvgTop) ; array.shift(fvgBot)
            array.shift(fvgIsBull) ; array.shift(fvgActive)

    if szBear > minFvgAtr * atrVal
        newFVGBear := true
        b = box.new(bar_index - 2, low[2], rEdge, high,
             border_color=colorFVGBear, bgcolor=colorFVGBear, border_width=zoneBorderWidth)
        array.push(fvgTop, low[2]) ; array.push(fvgBot, high)
        array.push(fvgIsBull, false) ; array.push(fvgActive, true) ; array.push(fvgBoxes, b)
        if array.size(fvgTop) > maxFVG
            box.delete(array.shift(fvgBoxes))
            array.shift(fvgTop) ; array.shift(fvgBot)
            array.shift(fvgIsBull) ; array.shift(fvgActive)

var bool ifvgCreated = false
ifvgCreated := false

if barstate.isconfirmed and array.size(fvgTop) > 0
    for i = array.size(fvgTop) - 1 to 0
        if array.get(fvgActive, i)
            t    = array.get(fvgTop, i)
            b    = array.get(fvgBot, i)
            mid  = (t + b) / 2.0
            bull = array.get(fvgIsBull, i)
            filled = switch fvgFillMode
                "Touch" => bull ? low <= t   : high >= b
                "50%"   => bull ? low <= mid : high >= mid
                "Full"  => bull ? low <= b   : high >= t
                => false
            if filled
                array.set(fvgActive, i, false)
                bx = array.get(fvgBoxes, i)
                if showIFVG
                    ifvgCreated := true
                    box.set_bgcolor(bx, colorIFVG)
                    box.set_border_color(bx, colorIFVG)
                else
                    box.delete(bx)
            else if extendZones
                box.set_right(array.get(fvgBoxes, i), bar_index + 50)

// ══════════════════════════════════════════════════════════════════════════════
// ORDER BLOCKS
// ══════════════════════════════════════════════════════════════════════════════
var array<float> obTop       = array.new<float>()
var array<float> obBot       = array.new<float>()
var array<int>   obLeft      = array.new<int>()
var array<bool>  obIsBull    = array.new<bool>()
var array<bool>  obActive    = array.new<bool>()
var array<box>   obBoxes     = array.new<box>()
var array<bool>  obConverted = array.new<bool>()

var bool newOBBull = false
var bool newOBBear = false
newOBBull := false
newOBBear := false

findOB(isBull, lb) =>
    idx = -1
    for j = 1 to lb
        if isBull
            if close[j] < open[j]
                idx := j ; break
        else
            if close[j] > open[j]
                idx := j ; break
    idx

addOB(isBull, oIdx) =>
    if oIdx >= 0
        hi  = obSource == "Full Range" ? high[oIdx] : math.max(open[oIdx], close[oIdx])
        lo  = obSource == "Full Range" ? low[oIdx]  : math.min(open[oIdx], close[oIdx])
        lft = bar_index - oIdx
        clr = isBull ? colorOBBull : colorOBBear
        rE  = extendZones ? bar_index + 50 : bar_index + 10
        b   = box.new(lft, hi, rE, lo, border_color=clr, bgcolor=clr, border_width=zoneBorderWidth)
        label.new(lft, hi, isBull ? "Bull OB" : "Bear OB",
             style=label.style_label_down, color=clr, textcolor=color.white, size=_lblSize)
        array.push(obTop, hi) ; array.push(obBot, lo) ; array.push(obLeft, lft)
        array.push(obIsBull, isBull) ; array.push(obActive, true)
        array.push(obConverted, false) ; array.push(obBoxes, b)
        if array.size(obTop) > maxOB
            box.delete(array.shift(obBoxes))
            array.shift(obTop) ; array.shift(obBot) ; array.shift(obLeft)
            array.shift(obIsBull) ; array.shift(obActive) ; array.shift(obConverted)

if barstate.isconfirmed and showOB and isDisplacement
    if bosBull or chochBull
        i = findOB(true, obLookback)
        if i >= 0
            newOBBull := true
            addOB(true, i)
    if bosBear or chochBear
        i = findOB(false, obLookback)
        if i >= 0
            newOBBear := true
            addOB(false, i)

if barstate.isconfirmed and array.size(obTop) > 0
    for i = array.size(obTop) - 1 to 0
        if array.get(obActive, i)
            t = array.get(obTop, i) ; b = array.get(obBot, i)
            broken = array.get(obIsBull, i) ? close < b : close > t
            if broken
                array.set(obActive, i, false)
                box.delete(array.get(obBoxes, i))
                if not array.get(obConverted, i)
                    array.set(obConverted, i, true)
            else if extendZones
                box.set_right(array.get(obBoxes, i), bar_index + 50)

// ══════════════════════════════════════════════════════════════════════════════
// BREAKER BLOCKS
// ══════════════════════════════════════════════════════════════════════════════
var array<float> bbTop    = array.new<float>()
var array<float> bbBot    = array.new<float>()
var array<bool>  bbIsBull = array.new<bool>()
var array<bool>  bbActive = array.new<bool>()
var array<box>   bbBoxes  = array.new<box>()

var bool newBB = false
newBB := false

if barstate.isconfirmed and showBB and array.size(obTop) > 0
    for i = array.size(obTop) - 1 to 0
        if array.get(obConverted, i) and not array.get(obActive, i)
            bbB   = not array.get(obIsBull, i)
            t     = array.get(obTop, i) ; b = array.get(obBot, i)
            lft   = array.get(obLeft, i)
            clr   = bbB ? colorBBBull : colorBBBear
            rE    = extendZones ? bar_index + 50 : bar_index + 10
            bx    = box.new(lft, t, rE, b, border_color=clr, bgcolor=clr,
                     border_width=zoneBorderWidth, border_style=line.style_dashed)
            label.new(lft, bbB ? b : t, bbB ? "Bull Breaker" : "Bear Breaker",
                 style=bbB ? label.style_label_up : label.style_label_down,
                 color=clr, textcolor=color.white, size=_lblSize)
            array.push(bbTop, t) ; array.push(bbBot, b)
            array.push(bbIsBull, bbB) ; array.push(bbActive, true) ; array.push(bbBoxes, bx)
            newBB := true
            array.set(obConverted, i, false)
            if array.size(bbTop) > maxOB
                box.delete(array.shift(bbBoxes))
                array.shift(bbTop) ; array.shift(bbBot)
                array.shift(bbIsBull) ; array.shift(bbActive)

var bool bbRetestBull = false
var bool bbRetestBear = false
bbRetestBull := false
bbRetestBear := false

if barstate.isconfirmed and showBBRe and array.size(bbTop) > 0
    for i = array.size(bbTop) - 1 to 0
        if array.get(bbActive, i)
            t = array.get(bbTop, i) ; b = array.get(bbBot, i)
            bull = array.get(bbIsBull, i)
            if close >= b and close <= t
                if bull then bbRetestBull := true else bbRetestBear := true
            if (bull and close < b) or (not bull and close > t)
                array.set(bbActive, i, false)
                box.delete(array.get(bbBoxes, i))
            else if extendZones
                box.set_right(array.get(bbBoxes, i), bar_index + 50)

// ══════════════════════════════════════════════════════════════════════════════
// ENTRY SETUP LOGIC (Section H)
// Conditions: price inside active zone + HTF bias aligned + confirmation candle
// ══════════════════════════════════════════════════════════════════════════════

// ── Confirmation candle patterns ────────────────────────────────────────────
bodyH    = math.abs(close - open)
lWick    = math.min(close, open) - low
uWick    = high - math.max(close, open)
range_   = high - low

// Bullish engulfing: current bar is bullish and fully engulfs prior bearish bar
bullEngulf = close > open and open[1] > close[1] and close > open[1] and open < close[1]
// Bearish engulfing
bearEngulf = close < open and open[1] < close[1] and close < open[1] and open > close[1]

// Hammer: lower wick ≥ 2× body, upper wick ≤ body, bullish close preferred
hammer       = lWick >= 2.0 * bodyH and uWick <= bodyH and range_ > 0
// Shooting star: upper wick ≥ 2× body, lower wick ≤ body
shootingStar = uWick >= 2.0 * bodyH and lWick <= bodyH and range_ > 0

bullConf = switch confType
    "Engulfing" => bullEngulf
    "Pin Bar"   => hammer
    "Both"      => bullEngulf or hammer
    => false

bearConf = switch confType
    "Engulfing" => bearEngulf
    "Pin Bar"   => shootingStar
    "Both"      => bearEngulf or shootingStar
    => false

// ── Zone membership check ────────────────────────────────────────────────────
// Price must have entered (touched) the zone this bar
var bool inBullZone  = false
var bool inBearZone  = false
var float bullZoneSL = na   // bottom of the bull zone for SL
var float bearZoneSL = na   // top  of the bear zone for SL
inBullZone  := false
inBearZone  := false
bullZoneSL  := na
bearZoneSL  := na

if barstate.isconfirmed
    // Check OBs
    if array.size(obTop) > 0
        for i = 0 to array.size(obTop) - 1
            if array.get(obActive, i)
                t = array.get(obTop, i) ; b = array.get(obBot, i)
                if array.get(obIsBull, i) and low <= t and close >= b
                    inBullZone := true
                    bullZoneSL := na(bullZoneSL) ? b : math.min(bullZoneSL, b)
                if not array.get(obIsBull, i) and high >= b and close <= t
                    inBearZone := true
                    bearZoneSL := na(bearZoneSL) ? t : math.max(bearZoneSL, t)
    // Check FVGs
    if array.size(fvgTop) > 0
        for i = 0 to array.size(fvgTop) - 1
            if array.get(fvgActive, i)
                t = array.get(fvgTop, i) ; b = array.get(fvgBot, i)
                if array.get(fvgIsBull, i) and low <= t and close >= b
                    inBullZone := true
                    bullZoneSL := na(bullZoneSL) ? b : math.min(bullZoneSL, b)
                if not array.get(fvgIsBull, i) and high >= b and close <= t
                    inBearZone := true
                    bearZoneSL := na(bearZoneSL) ? t : math.max(bearZoneSL, t)
    // Check Breakers
    if array.size(bbTop) > 0
        for i = 0 to array.size(bbTop) - 1
            if array.get(bbActive, i)
                t = array.get(bbTop, i) ; b = array.get(bbBot, i)
                if array.get(bbIsBull, i) and low <= t and close >= b
                    inBullZone := true
                    bullZoneSL := na(bullZoneSL) ? b : math.min(bullZoneSL, b)
                if not array.get(bbIsBull, i) and high >= b and close <= t
                    inBearZone := true
                    bearZoneSL := na(bearZoneSL) ? t : math.max(bearZoneSL, t)

// ── Entry signals ────────────────────────────────────────────────────────────
// All 3 conditions must be met: zone + HTF bias + confirmation candle
setupLong  = barstate.isconfirmed and showEntry and inBullZone and htfBull and bullConf
setupShort = barstate.isconfirmed and showEntry and inBearZone and htfBear and bearConf

if setupLong
    label.new(bar_index, low,  "⚡ Setup Long",
         style=label.style_label_up, color=colorSetupL,
         textcolor=color.black, size=size.normal)
    if showSLLine and not na(bullZoneSL)
        line.new(bar_index - 3, bullZoneSL, bar_index + 10, bullZoneSL,
             color=color.new(colorSetupL, 30), style=line.style_dashed, width=1)

if setupShort
    label.new(bar_index, high, "⚡ Setup Short",
         style=label.style_label_down, color=colorSetupS,
         textcolor=color.white, size=size.normal)
    if showSLLine and not na(bearZoneSL)
        line.new(bar_index - 3, bearZoneSL, bar_index + 10, bearZoneSL,
             color=color.new(colorSetupS, 30), style=line.style_dashed, width=1)

// ── HTF bias bar color (subtle background) ───────────────────────────────────
bgcolor(htfBull ? color.new(#00C853, 97) : htfBear ? color.new(#D50000, 97) : na,
     title="HTF Bias Background")

// ══════════════════════════════════════════════════════════════════════════════
// PLOTS — Swing markers
// ══════════════════════════════════════════════════════════════════════════════
plotshape(not na(swingHigh) ? swingHigh : na, "SH", shape.triangledown,
     location.abovebar, color.new(#FF5722, 40), size=size.tiny)
plotshape(not na(swingLow)  ? swingLow  : na, "SL", shape.triangleup,
     location.belowbar, color.new(#2196F3, 40), size=size.tiny)

// ══════════════════════════════════════════════════════════════════════════════
// ALERT CONDITIONS (12 total)
// ══════════════════════════════════════════════════════════════════════════════
alertcondition(alertOnBOS   and bosBull,    "BOS Bullish",     "BOS↑ Break of Structure")
alertcondition(alertOnBOS   and bosBear,    "BOS Bearish",     "BOS↓ Break of Structure")
alertcondition(alertOnCHoCH and chochBull,  "CHoCH Bullish",   "CHoCH↑ Change of Character")
alertcondition(alertOnCHoCH and chochBear,  "CHoCH Bearish",   "CHoCH↓ Change of Character")
alertcondition(alertOnFVG   and newFVGBull, "New Bull FVG",    "Bullish FVG detected")
alertcondition(alertOnFVG   and newFVGBear, "New Bear FVG",    "Bearish FVG detected")
alertcondition(alertOnIFVG  and ifvgCreated,"FVG → IFVG",      "FVG converted to IFVG")
alertcondition(alertOnOB    and newOBBull,  "New Bull OB",     "Bullish Order Block")
alertcondition(alertOnOB    and newOBBear,  "New Bear OB",     "Bearish Order Block")
alertcondition(alertOnBB    and newBB,      "New Breaker",     "Breaker Block formed")
alertcondition(alertOnEntry and setupLong,  "Entry Setup Long","⚡ Long setup: zone + HTF bull + confirmation")
alertcondition(alertOnEntry and setupShort, "Entry Setup Short","⚡ Short setup: zone + HTF bear + confirmation")
